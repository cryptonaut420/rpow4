# --- Runtime ---
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://localhost:5432/rpow_dev
DATABASE_POOL_MAX=30
DATABASE_STATEMENT_TIMEOUT_MS=5000

# --- Secrets ---
# Random 32+ byte string. Used for HMAC over session cookies and challenges.
SESSION_SECRET=replace-with-32-plus-bytes-of-randomness
# Ed25519 keypair (hex). The server signs ledger events with this private key.
RPOW_SIGNING_PRIVATE_KEY_HEX=...
RPOW_SIGNING_PUBLIC_KEY_HEX=...

# --- Mining schedule ---
# Initial trailing-zero-bit difficulty. The schedule starts here at block 0
# and steps up by +1 every DIFFICULTY_STEP_BLOCKS blocks (capped at MAX_BITS).
DIFFICULTY_BITS=24
DIFFICULTY_STEP_BLOCKS=50000
DIFFICULTY_MAX_BITS=50
# Friction PoW for /signup. Lower than mining difficulty by design.
SIGNUP_DIFFICULTY_BITS=18
# Issuance schedule. Defaults match Bitcoin: 50 RPOW × 210,000 × 2 = 21,000,000.
MINT_BASE_REWARD_BASE_UNITS=50000000000
HALVING_INTERVAL_BLOCKS=210000
MINT_MAX_SUPPLY=21000000

# --- Fees ---
# Per-send fee paid to the treasury. Halves with every reward halving. 0 to disable.
SEND_BASE_FEE_BASE_UNITS=1000000000

# --- Faucet ---
FAUCET_ENABLED=true
FAUCET_CLAIM_AMOUNT_BASE_UNITS=5000000000
FAUCET_COOLDOWN_HOURS=24

# --- Trollbox ---
TROLLBOX_POST_FEE_BASE_UNITS=5000000000

# --- Pool ---
POOL_ENABLED=true
POOL_FEE_BPS=200
POOL_FINDER_BPS=2500
POOL_SHARE_BITS=24
POOL_CHALLENGE_TTL_SECONDS=300

# --- HTTP / proxy ---
WEB_ORIGIN=http://localhost:5173
# Set to true (or a CIDR) when running behind a trusted reverse proxy so
# req.ip/X-Forwarded-For are honored. Leave false for direct exposure.
TRUST_PROXY=false
TURNSTILE_SECRET=

# --- RPOW2 bridge integration ---
# RPOW2_SESSION_COOKIE is copied from a browser session after logging in
# as the deposit/withdraw account on RPOW2 (full cookie, e.g. rpow_session=...).
# RPOW2_BANKER_EMAIL is the email shown to users as the deposit address.
# RPOW2_DEPOSIT_POLL_ENABLED toggles the background deposit poller.
RPOW2_API_BASE_URL=https://api.rpow2.com
RPOW2_BANKER_EMAIL=rpow4bank@gmail.com
RPOW2_SESSION_COOKIE=
RPOW2_DEPOSIT_POLL_ENABLED=false
