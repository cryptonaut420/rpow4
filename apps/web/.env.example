VITE_API_BASE_URL=http://localhost:8080
# Public URL used to generate sitemap.xml and robots.txt at build time
VITE_APP_URL=https://your-domain.com

# PostHog (optional — leave token unset to disable client analytics)
# Keys: PostHog → Project → Project API key
VITE_PUBLIC_POSTHOG_TOKEN=
# US cloud default; use https://eu.i.posthog.com for EU region projects
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
