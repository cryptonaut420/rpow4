# Keep the build context tiny — the dev compose stack uses bind mounts for
# the source tree, so Docker only needs the files referenced by Dockerfiles.
.git
.github
node_modules
**/node_modules
**/dist
**/.vite
**/.cache
**/.next
playwright-report
test-results
coverage
*.tsbuildinfo
.env
.env.*
*.log
.DS_Store
docs
ops
