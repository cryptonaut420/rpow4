# Copy to prod.env or run ./deploy-aws-ec2.sh to generate prod.env safely.
#
# DNS required before first certificate issuance:
#   rpow4.com     A/AAAA -> this EC2 public IP
#   api.rpow4.com A/AAAA -> this EC2 public IP

COMPOSE_PROJECT_NAME=rpow4-prod

WEB_HOST=rpow4.com
API_HOST=api.rpow4.com
LETSENCRYPT_EMAIL=admin@rpow4.com

NODE_ENV=production
PORT=8080
WEB_ORIGIN=https://rpow4.com

DATABASE_POOL_MAX=30
DATABASE_STATEMENT_TIMEOUT_MS=5000
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgres://rpow:replace-me@db:5432/rpow

SESSION_SECRET=replace-with-64-hex-chars
RPOW_SIGNING_PRIVATE_KEY_HEX=replace-with-64-hex-chars
RPOW_SIGNING_PUBLIC_KEY_HEX=replace-with-64-hex-chars

DIFFICULTY_BITS=24
DIFFICULTY_STEP_BLOCKS=50000
DIFFICULTY_MAX_BITS=50
SIGNUP_DIFFICULTY_BITS=18
MINT_BASE_REWARD_BASE_UNITS=50000000000
HALVING_INTERVAL_BLOCKS=210000
MINT_MAX_SUPPLY=21000000
SEND_BASE_FEE_BASE_UNITS=1000000000

FAUCET_ENABLED=true
FAUCET_CLAIM_AMOUNT_BASE_UNITS=5000000000
FAUCET_COOLDOWN_HOURS=24
TROLLBOX_POST_FEE_BASE_UNITS=5000000000
