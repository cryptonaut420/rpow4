# Dev defaults loaded by every service in compose.yaml via `env_file`.
# DO NOT use any of these values outside local dev. Override per-service in
# compose.yaml or via a sibling `dev.env.local` (gitignored) for personal
# tweaks.
#
# Vars not listed here either fall back to defaults defined in
# apps/server/src/env.ts or are injected by the entrypoint scripts.

NODE_ENV=development
PORT=8080

# 32+ chars required by the env schema. Rotate freely in dev.
SESSION_SECRET=dev-session-secret-do-not-use-in-prod-rotate-me

# RPOW4 schedule: difficulty starts at DIFFICULTY_BITS and steps +1 every
# DIFFICULTY_STEP_BLOCKS blocks (capped at DIFFICULTY_MAX_BITS). Reward
# starts at MINT_BASE_REWARD_BASE_UNITS and halves every
# HALVING_INTERVAL_BLOCKS.
#
# Dev mirrors the production schedule (24-bit start) so local mining feels
# like the real thing — expect ~10–60s per accepted PoW depending on CPU.
# To iterate faster on the mine flow itself, drop DIFFICULTY_BITS in your
# gitignored docker/dev.env.local (e.g. =18 ≈ sub-second, =14 ≈ instant).
DIFFICULTY_BITS=24
DIFFICULTY_STEP_BLOCKS=164062
DIFFICULTY_MAX_BITS=50

# Anti-spam PoW for /signup. 12 bits ≈ 4k hashes — instant in a browser
# WebWorker, so creating throwaway dev wallets isn't slowed down by the
# anti-spam PoW. Production default is 18 bits.
SIGNUP_DIFFICULTY_BITS=12

# Block-based issuance defaults (Bitcoin-flavored, 21M cap closes
# exactly with these constants).
MINT_BASE_REWARD_BASE_UNITS=50000000000
HALVING_INTERVAL_BLOCKS=210000
MINT_MAX_SUPPLY=21000000

# Force polling-based file watchers — needed for reliable HMR on macOS or
# Windows hosts (where bind-mounted folders don't propagate inotify
# events). Negligible cost on Linux hosts.
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=300

