# Dev defaults loaded by every service in compose.yaml via `env_file`.
# DO NOT use any of these values outside local dev. Override per-service in
# compose.yaml or via a sibling `dev.env.local` (gitignored) for personal
# tweaks.
#
# Vars not listed here either fall back to defaults defined in
# apps/server/src/env.ts or are injected by the entrypoint scripts.

NODE_ENV=development
PORT=8080

# RPOW_TEST_INBOX=true makes the server wire up the FakeMailer regardless
# of MAILER, and prints magic links + claim links to stdout. Watch the
# server logs to grab them: `docker compose logs -f server`.
RPOW_TEST_INBOX=true

# env validation still requires RESEND_API_KEY when MAILER=resend (the
# default). The dummy value is never used because RPOW_TEST_INBOX wins.
MAILER=resend
RESEND_API_KEY=re_dev_dummy_unused_when_test_inbox

# Must match either an email or "Name <email>".
EMAIL_FROM=rpow2 dev <no-reply@rpow2.local>

# 32+ chars required by the env schema. Rotate freely in dev.
SESSION_SECRET=dev-session-secret-do-not-use-in-prod-rotate-me

# Halving model: schedule is constant in difficulty, so DIFFICULTY_BITS
# directly drives the stamped difficulty. Keep low so manual mining
# completes in well under a second per token.
DIFFICULTY_BITS=14
DIFFICULTY_FLOOR=8

# Plenty of headroom for the dev cap.
MINT_MAX_SUPPLY=21000000

# Crank the outbound mail throttle so manual flows never hit it.
MAIL_THROTTLE_RPS=20
MAIL_THROTTLE_MAX_QUEUE=1000

# Force polling-based file watchers — needed for reliable HMR on macOS or
# Windows hosts (where bind-mounted folders don't propagate inotify
# events). Negligible cost on Linux hosts.
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=300

# SRPOW intentionally left disabled. The server falls back to
# FakeBridgeClient when SOLANA_RPC_URL / SRPOW_MINT_ADDRESS /
# BRIDGE_KEYPAIR_BASE58 are not all set, and `/srpow/wrap` returns a
# disabled-style 403 to the allowlist gate. To enable wrap in dev:
#   1. Provide your own three SRPOW_* vars (or use a private devnet)
#   2. Add your dev email to WRAP_ALLOWED_EMAILS
