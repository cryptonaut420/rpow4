{
  "name": "rpow",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b apps/server packages/shared && npm --workspace apps/web run build",
    "test": "npm --workspace packages/shared test && npm --workspace apps/server test && npm --workspace apps/web test",
    "lint": "tsc -b --noEmit && eslint .",
    "dev:server": "npm --workspace apps/server run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "toggle-send-fees": "npm --workspace @rpow/server run toggle-send-fees --",
    "toggle-admin": "npm --workspace @rpow/server run toggle-admin --"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.5"
  },
  "overrides": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
